
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
</head>

<body>
    <%- include("../partials/header") %>

    <main class="messages">
        <h4><%= title %></h4>

        <% if (messages && messages.length > 0) { %>

            <% messages.forEach(message => { %>

                <div class="message-container">
                    <p>
                        <strong><%= message.title %></strong>
                    </p>

                    <p>
                        <%= message.description %>
                    </p>

                    <% if (isClubMember || isAdmin) { %>
                        <p>
                            <span>
                                From: <%= message.first_name %>
                                <%= message.last_name %>
                            </span>

                            <span>
                                Posted on: <%= message.created_at %>
                            </span>
                        </p>
                    <% } else { %>
                        <p>
                            <span>From: an anonymous user</span>
                        </p>
                    <% } %>

                    <% if (isAdmin || message.user_id === userId) { %>
                        <a href="/message/delete/<%= message.id %>">
                            Delete
                        </a>
                    <% } %>

                </div>

            <% }); %>

        <% } else { %>

            <p>No messages found.</p>

        <% } %>

    </main>

    <%- include("../partials/footer.ejs") %>
</body>

</html>
